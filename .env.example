# Optional advanced settings for Hidari (Rust / Tauri).
# The app works with NO .env at all — copy this only if you need overrides.
#
# Dev:  copy to `.env` in the project root (same folder as package.json)
#       then run `npm run tauri:dev`
# Release: you can also put a `.env` in the app config folder
#       (e.g. %APPDATA%\com.mylauncher.app\config\.env on Windows)
#
# Never commit a real `.env` (it is gitignored).

# --- Steam Web API (optional) ---
# Used only to refresh the local Steam appid index via the official API.
# Without it, Hidari uses a public appid mirror. Covers/search still work.
# Get a key: https://steamcommunity.com/dev/apikey
# STEAM_WEB_API_KEY=your_key_here

# --- Hydra API base URL (optional) ---
# Used for online Hydra catalogue/download lookups when local cache is thin.
# Default in code: https://hydra-api-us-east-1.losbroxas.org
# HYDRA_API_URL=https://hydra-api-us-east-1.losbroxas.org

# --- HydraLinks catalog mirror (optional) ---
# Alternate base to download source .json files. Use {file} as placeholder.
# Without it: https://hydralinks.cloud/sources/{file} + local cache.
# HYDRALINKS_MIRROR_URL=https://example.com/mirror/{file}
