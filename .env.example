# Opcional — índice Steam via API oficial (https://steamcommunity.com/dev/apikey).
# Sem isto, o launcher usa um espelho público de appids e a busca da loja Steam.
STEAM_WEB_API_KEY=

# Opcional — URL base da API Hydra (pesquisa online quando não há cache local).
# Padrão: https://hydra-api-us-east-1.losbroxas.org
# HYDRA_API_URL=https://api.hydralauncher.gg

# Opcional — espelho alternativo para baixar catálogos .json localmente.
# Use {file} como placeholder (ex.: fitgirl.json). Sem isto: URL oficial hydralinks + cache local.
# HYDRALINKS_MIRROR_URL=https://example.com/mirror/{file}
