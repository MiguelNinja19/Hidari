{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hidari",
  "version": "0.1.0",
  "identifier": "com.mylauncher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hidari",
        "width": 1094,
        "height": 816,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "theme": "Dark",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hidari", "mylauncher"]
      }
    },
    "updater": {
      "active": false,
      "endpoints": [],
      "dialog": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/README.txt",
      "binaries/aria2c.exe",
      "binaries/download-engine.exe",
      "binaries/7za.exe",
      "binaries/7za.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
