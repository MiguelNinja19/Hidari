{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hidari",
  "version": "0.1.2",
  "identifier": "com.hidari.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hidari",
        "width": 1280,
        "height": 816,
        "minWidth": 1280,
        "minHeight": 816,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "theme": "Dark",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost https://cdn.cloudflare.steamstatic.com https://cdn.akamai.steamstatic.com https://shared.akamai.steamstatic.com https://steamcdn-a.akamaihd.net https://store.steampowered.com https://hydra-api-us-east-1.losbroxas.org https://hydralinks.cloud https://raw.githubusercontent.com; font-src 'self' data:; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data: https://cdn.cloudflare.steamstatic.com https://cdn.akamai.steamstatic.com https://shared.akamai.steamstatic.com https://steamcdn-a.akamaihd.net; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hidari"]
      }
    },
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1ODhFMjU2Q0QxRDM2NUEKUldSYU5oM05WdUtJdFV4SnZzR053TzlaQmtPQXlvVkR3dzFxRG5zS01RT1NCUk91ZHFXbkdOTFoK",
      "endpoints": [
        "https://github.com/melx-999/Hidari/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "Hidari",
    "shortDescription": "Hidari — launcher de jogos",
    "longDescription": "Hidari é um launcher de jogos com catálogo, downloads e biblioteca local.",
    "resources": [
      "binaries/README.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "windows/nsis/header.bmp",
        "sidebarImage": "windows/nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "startMenuFolder": "Hidari",
        "displayLanguageSelector": true,
        "languages": ["PortugueseBR", "English", "Spanish", "Russian"]
      }
    }
  }
}
